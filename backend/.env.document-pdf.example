# Merge into the existing environment; do not commit real credentials.
FILLFASTER_API_TOKEN=
# Dedicated blank/minimal form template with no overlays. Verify account support.
FILLFASTER_BASE_PDF_FID=

# Keep legacy issuance until a prepared PDF has been signed and independently verified.
DOCUMENT_PDF_PREVIEW_RENDERER=local
DOCUMENT_PDF_RENDERER=legacy
DOCUMENT_PDF_LOCAL_SIGNING_VALIDATED=false

# Chromium installed by Dockerfile; Windows may use Chrome or Edge.
PDF_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Leave false when the host supports Chromium sandboxing. Constrained container
# hosts may require explicit true; rendering blocks scripts and all network/file requests.
PDF_CHROMIUM_NO_SANDBOX=false
