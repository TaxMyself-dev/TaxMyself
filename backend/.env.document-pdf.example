# Cloud Run PDFs render in the private standalone service. Use its root URL.
# Local development may use http://127.0.0.1:8082 or the installed browser if unset.
PDF_SERVICE_URL=
# Signing remains in the backend and uses template 3IfhJjgmAp.
# Keep the API token in secret configuration, never in source control.
FILLFASTER_API_TOKEN=
