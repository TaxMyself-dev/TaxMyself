COMPOSIO_ENVIRONMENT=dev
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_TOOLKIT_VERSION=20261105_00
COMPOSIO_GMAIL_CALLBACK_URL=http://localhost:3000/integrations/google/callback
GMAIL_FRONTEND_URL=http://localhost:4200/settings?tab=permissions
# Exact HTTPS download hostnames, comma-separated; determine during approved DEV verification.
COMPOSIO_DOWNLOAD_ALLOWED_HOSTS=
# Prevent boot-time schema synchronization; apply reviewed SQL separately.
DISABLE_SYNCHRONIZE=true
