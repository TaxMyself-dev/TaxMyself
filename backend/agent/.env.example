# The agent's settings. The agent runs inside the Nest backend's process, so
# in the backend these go in backend/.env with the backend's own (the backend
# loads it with dotenv). The task worker, the evals and the harness read
# backend/.env and then backend/agent/.env.local (npm scripts, --env-file).
# .env.local is git-ignored.

# --- Required ---

# The agent's model (gpt-6-luna through OpenAI's Responses API).
OPENAI_API_KEY=

# Jev (TypeSafe): the turn signals, the answer check, the monitor's scoring
# and the eval judges. A failing or slow Jev never blocks an answer.
TYPESAFE_API_KEY=

# The database: the backend's own MySQL (DB_HOST, DB_PORT, DB_USERNAME,
# DB_PASSWORD, DB_DATABASE in backend/.env), with the agent's tables from
# backend/scripts/migrations/2026-10-22_agent_harness_schema.sql. Set these
# only to point the agent at another database.
AGENT_DB_HOST=
AGENT_DB_PORT=
AGENT_DB_USERNAME=
AGENT_DB_PASSWORD=
AGENT_DB_DATABASE=

# The origins the Angular app is served from, comma-separated: the agent's
# cross-site guard lets their pages call it. Required: the app calls the API
# from another origin, and without its origin here every chat request is
# refused (403 AGENT_INVALID_ORIGIN).
# Example: https://app.keepintax.co.il,http://localhost:4200
AGENT_APP_ORIGINS=

# --- Langfuse traces (optional) ---
#
# Development: a self-hosted Langfuse on this machine (GUIDE.md, "Langfuse"),
# LANGFUSE_BASE_URL=http://localhost:3000 with that instance's project keys;
# evals trace only to a local Langfuse (vitest.config.ts).
# Production: Langfuse Cloud, LANGFUSE_BASE_URL=https://cloud.langfuse.com
# (the default when unset) with the cloud project's keys.
# Without both keys nothing is traced. Phone numbers and emails are masked.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_SAMPLE_RATE=
# The environment label on every trace (development, production, eval);
# "development" when unset.
LANGFUSE_TRACING_ENVIRONMENT=

# --- Optional ---

# PostHog product events from the server (tasks created, opportunities filed,
# each agent message and tool used, never what the user typed).
VITE_POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Voice dictation in the chat composer (a short-lived key per dictation).
SONIOX_API_KEY=

# Switches: "false" turns the turn signals or the answer check off.
AGENT_TURN_SIGNALS=
AGENT_ANSWER_CHECK=
# "off" runs the task worker without scanning.
TASK_MONITOR=

# Where the Nest backend loads the agent from (backend/agent/dist/
# agent-http.mjs, built by `npm run build` in backend/agent, by default).
AGENT_BUNDLE_PATH=

# Where local speed measurements of the main journeys are kept.
JOURNEY_TIMINGS_FILE=journey-timings.local

# --- Evals ---

# The agent ids (agent_users.id, not Firebase uids) whose real chats
# mine-agent-chats.ts reads, comma-separated.
AGENT_EVAL_MINE_USER_IDS=
# The Claude Code CLI the harness runs (~/.local/bin/claude by default).
CLAUDE_CLI_PATH=

# --- Tests ---

# A MySQL with the agent's tables for the gateway's and the HTTP entry's
# integration tests (skipped without it). Never a shared or production
# database: every run writes test users and rows.
# Example: mysql://root@127.0.0.1:3307/agent_test
AGENT_TEST_DATABASE_URL=
