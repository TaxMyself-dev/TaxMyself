# Disabled until SQL and controlled activation are explicitly approved.
GMAIL_DURABLE_INTAKE_ENABLED=false
GMAIL_DURABLE_SCAN_ENABLED=false
GMAIL_DURABLE_PROCESS_ENABLED=false
GMAIL_DURABLE_DELETE_ENABLED=false

# Optional controlled-rollout bounds; unset means unrestricted owned scope.
# IDs are positive internal user_integrations IDs, comma separated.
# GMAIL_DURABLE_ALLOWED_INTEGRATION_IDS=123
# Required resolved businessNumber, NOT the numeric Business row ID.
# GMAIL_DURABLE_REQUIRED_BUSINESS_NUMBER=synthetic-business
# Legacy Inbox OCR pause (unset preserves existing behavior).
# INBOX_OCR_ENABLED=false
