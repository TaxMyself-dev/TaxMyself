/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["node"],
    // Libraries' declaration files are not type-checked (Angular's default):
    // the AI SDK's (the agent's dev page, pages/dev-agent) need TypeScript
    // 5.7+, and this app is on 5.5. The app's own code is checked as before.
    "skipLibCheck": true
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ]
}