        {
          "name": "01 Import PDF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-whatsapp-dev-token",
                "value": "{{devToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/dev/whatsapp/documents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageId\": \"{{runId}}-upload\",\n  \"from\": \"972500000001\",\n  \"filename\": \"receipt.pdf\",\n  \"mimeType\": \"application/pdf\",\n  \"contentBase64\": \"{{contentBase64}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Expected status', () => pm.expect(pm.response.json().status).to.eql('IMPORTED'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
                  "function base64(s) { const a = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'; let r = ''; for(let i=0;i<s.length;i+=3){ const x=s.charCodeAt(i), y=s.charCodeAt(i+1), z=s.charCodeAt(i+2); const n=(x<<16)|((y||0)<<8)|(z||0); r+=a[(n>>>18)&63]+a[(n>>>12)&63]+(i+1<s.length?a[(n>>>6)&63]:'=')+(i+2<s.length?a[n&63]:'='); } return r; }",
                  "function pdf(tag) { let s='%PDF-1.4\\n% '+tag+'\\n'; const offsets=[0]; const objects=['<< /Type /Catalog /Pages 2 0 R >>','<< /Type /Pages /Kids [3 0 R] /Count 1 >>','<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 4 0 R >>','<< /Length 0 >>\\nstream\\n\\nendstream']; objects.forEach((o,i)=>{offsets.push(s.length);s+=(i+1)+' 0 obj\\n'+o+'\\nendobj\\n';}); const x=s.length; s+='xref\\n0 5\\n0000000000 65535 f \\n'; offsets.slice(1).forEach(o=>{s+=String(o).padStart(10,'0')+' 00000 n \\n';}); s+='trailer\\n<< /Root 1 0 R /Size 5 >>\\nstartxref\\n'+x+'\\n%%EOF\\n'; return base64(s); }",
                  "pm.collectionVariables.set('contentBase64',pdf(pm.collectionVariables.get('runId')));",
                  "pm.collectionVariables.set('retryContentBase64',pdf(pm.collectionVariables.get('runId')+'-retry'));"
                ]
              }
            }
          ]
        },
