# Set on the proxy Cloud Run service; this file is a template, not loaded automatically.
LYCHEE_DB_HOST=REPLACE_WITH_DEV_MYSQL_HOST
LYCHEE_DB_PORT=3306
LYCHEE_DB_NAME=keepintax-dev
LYCHEE_DB_USER=REPLACE_WITH_EXISTING_AUTHORIZED_DEV_USER
LYCHEE_DB_PASSWORD=REPLACE_WITH_DEV_PASSWORD_SECRET
# TLS defaults to true; a private/self-signed CA requires LYCHEE_DB_SSL_CA (PEM secret).
LYCHEE_DB_SSL=true
